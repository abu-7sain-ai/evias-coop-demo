{
  "name": "evias-coop-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "E-VIAS cooperative-society platform — standalone government demo on synthetic data",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "data": "node scripts/generate-data.mjs --out public/data",
    "check:data": "node scripts/check-stories.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "prebuild": "node scripts/generate-data.mjs --out public/data && node scripts/check-stories.mjs",
    "build": "tsc -b && vite build && node scripts/build-bridge-tools.mjs",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "bridge": "node bridge/server.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cross-spawn": "^7.0.6",
    "i18next": "^26.5.7",
    "lucide-react": "^1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.1.5",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
